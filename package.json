{
  "homepage": "https://chhunvirak.github.io/Potfolio",
  "name": "potfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "devh": "vite --host",
    "build": "tsc && vite build",
    "postbuild": "mkdir -p dist/potfolio dist/blog dist/profile && cp dist/index.html dist/potfolio/index.html && cp dist/index.html dist/blog/index.html && cp dist/index.html dist/profile/index.html",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "ayu": "^8.0.1",
    "firebase": "^12.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.16.0",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.38.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "gh-pages": "^5.0.0",
    "tailwind-plugin-typed": "^1.1.2",
    "typescript": "^5.0.2",
    "vite": "^7.1.2"
  }
}
